            "value": "Edit"
          }
        }
      }
    },
    "自動": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic"
          }
        }
      }
    },
    "自動は画面の大きさに合わせて解像度を変えます（サーバーが対応している場合）。「画面の端まで使う」をオフにすると、Dynamic Island や画面の角を避けて表示します。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic changes the resolution to fit the screen (when the server supports it). With “Use the whole screen” off, the desktop stays clear of the Dynamic Island and the screen's corners."
          }
        }
      }
    },
    "自動再接続": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto Reconnect"
          }
        }
      }
    },
    "自動（安全な方式のみ）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic (secure only)"
          }
        }
      }
    },
    "自動（画面に合わせる）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic (fit the screen)"
          }
        }
      }
    },
    "自動（端末に合わせる）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic (match this device)"
          }
        }
      }
    },
    "自己署名または独自 CA の証明書です。チェーンと有効期間は確認済みですが、この証明書を保証する第三者はいません。下のフィンガープリントが接続先のサーバーのものであることを、別の手段で確認してください。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This certificate is self-signed or from a private CA. The chain and validity period are checked, but no third party vouches for it. Confirm by some other means that the fingerprint below belongs to the server."
          }
        }
      }
    },
    "英数": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eisu"
          }
        }
      }
    },
    "英数/かな、変換/無変換、修飾キーなど文字を生まないキーだけを、メモリ上に最大 %lld 件記録します。保存も送信もしません。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records up to %lld presses of keys that don't type characters (Eisu/Kana, Henkan/Muhenkan, modifiers, and so on) in memory only. Nothing is saved or sent."
          }
        }
      }
    },
    "英数/かなで Windows の IME を切り替える": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch the Windows IME with Eisu/Kana"
          }
        }
      }
    },
    "英数→無変換、かな→変換の変換が保証されるのは日本語レイアウトのみです。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eisu → Muhenkan and Kana → Henkan are guaranteed only with the Japanese layout."
          }
        }
      }
    },
    "英数→無変換、かな→変換の変換が保証されるのは日本語レイアウトのみです。接続先ごとに上書きできます。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eisu → Muhenkan and Kana → Henkan are guaranteed only with the Japanese layout. Each computer can override this."
          }
        }
      }
    },
    "英数は無変換、かなは変換として送ります。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eisu is sent as Muhenkan, and Kana as Henkan."
          }
        }
      }
    },
    "表示": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display"
          }
        }
      }
    },
    "表示しない": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never"
          }
        }
      }
