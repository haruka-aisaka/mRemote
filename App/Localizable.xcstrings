          }
        }
      }
    },
    "接続先が見つかりません": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection Not Found"
          }
        }
      }
    },
    "接続先と同じユーザーでサインイン": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign In as the Computer's User"
          }
        }
      }
    },
    "接続先に接続": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to Computer"
          }
        }
      }
    },
    "接続先の一覧": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Computers"
          }
        }
      }
    },
    "接続先を IP アドレスで指定したため、証明書のホスト名は検証されていません。Windows の自己署名証明書はコンピューター名しか持たないため、IP 指定では照合が成立しません。識別の根拠はフィンガープリントだけです。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Because the computer is given by IP address, the certificate's host name isn't verified. A Windows self-signed certificate names only the computer, so it can't match an IP address. Only the fingerprint identifies the server."
          }
        }
      }
    },
    "接続先を編集": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit Computer"
          }
        }
      }
    },
    "接続先を読み込む": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import Connection"
          }
        }
      }
    },
    "接続先を読み込めません": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't Load Computers"
          }
        }
      }
    },
    "接続先を追加": {
