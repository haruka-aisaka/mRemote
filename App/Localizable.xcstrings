      }
    },
    "本のように横向きで少し折ったときも、フル PC キーボードを画面の下に出します（左右分割の設定に従います）。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folded a little while held sideways, like a book, the PC keyboard also comes up along the bottom (split if that is on)."
          }
        }
      }
    },
    "標準": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Natural"
          }
        }
      }
    },
    "横向きでは左右に分ける": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Split in landscape"
          }
        }
      }
    },
    "横向きで折り曲げたときもフル PC キーボードを出す": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the PC keyboard when folded sideways"
          }
        }
      }
    },
    "次に確定した文字を、リモートのクリップボードを上書きして貼り付けで送ります。Unicode 入力を受け付けないアプリ向け": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends the next committed text by pasting it, replacing the remote clipboard. For apps that don't accept Unicode input."
          }
        }
      }
    },
    "次の1キー": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next key only"
          }
        }
      }
    },
    "次の入力を貼り付けで送る（クリップボード上書き）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste next input (replaces clipboard)"
          }
        }
      }
    },
    "無効": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off"
          }
        }
      }
    },
    "無変換": {
      "localizations": {
        "en": {
          "stringUnit": {
